{
  "name": "SmartOCRMobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e:android": "detox test -c android.emu.debug",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "test:all": "npm run test:coverage",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.3",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "react-native-screens": "^3.34.0",
    "react-native-safe-area-context": "^4.10.9",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react-native-image-picker": "^7.1.2",
    "react-native-vision-camera": "^4.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.9",
    "@babel/preset-typescript": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@testing-library/react-native": "^12.5.1",
    "@testing-library/jest-native": "^5.4.3",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
    "setupFilesAfterEnv": ["./jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-screens|react-native-safe-area-context|react-native-image-picker|react-native-vision-camera|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/types/**",
      "!src/navigation/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 75,
        "branches": 70,
        "statements": 80
      }
    }
  }
}
